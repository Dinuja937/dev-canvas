datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  googleId      String         @unique
  email         String         @unique // Received from Google OAuth profile
  name          String         // Received from Google OAuth profile
  profilePic    String?        // URL string received from Google OAuth profile
  role          Role           @default(STUDENT)
  createdAt     DateTime       @default(now())
  
  // Relationships
  projects      Project[]      @relation("StudentProjects")
  likes         Like[]
  
  // Follower system (Self-relation)
  following     Follower[]     @relation("UserFollowing")
  followers     Follower[]     @relation("UserFollowers")
  
  notifications Notification[]
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  coverImage  String   // Primary eye-catching preview image
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // Tracks updates as requested by your lecturer
  
  // Relationships
  studentId   String
  student     User     @relation("StudentProjects", fields: [studentId], references: [id], onDelete: Cascade)
  
  
  likes       Like[]
}

model Like {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId]) // Ensures a single user cannot like a project multiple times
}

model Follower {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // Ensures a user cannot follow the same person twice
}

model Notification {
  id        String   @id @default(uuid())
  message   String   // e.g., "Mary liked your project."
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}