        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nmermaid\nerDiagram\n    USER ||--o{ PROJECT : \&quot;creates\&quot;\n    USER ||--o{ LIKE : \&quot;likes\&quot;\n    PROJECT ||--o{ LIKE : \&quot;is liked by\&quot;\n    USER ||--o{ FOLLOWER : \&quot;follows (as follower)\&quot;\n    USER ||--o{ FOLLOWER : \&quot;is followed (as following)\&quot;\n    USER ||--o{ NOTIFICATION : \&quot;receives\&quot;\n \n    USER {\n        ObjectId _id PK\n        string googleId UK\n        string email UK\n        string name\n        string profilePic\n        string role \&quot;STUDENT | RECRUITER | ADMIN\&quot;\n        string bio\n        string[] technologies\n        string location\n        string institute\n        boolean isNewUser\n        boolean isDisabled\n        date createdAt\n        date updatedAt\n    }\n \n    PROJECT {\n        ObjectId _id PK\n        string title\n        string description\n        string coverImage\n        string[] images\n        string githubUrl\n        string demoUrl\n        string[] tags\n        ObjectId studentId FK \&quot;ref: User\&quot;\n        date createdAt\n        date updatedAt\n    }\n \n    LIKE {\n        ObjectId _id PK\n        ObjectId userId FK \&quot;ref: User (recruiter)\&quot;\n        ObjectId projectId FK \&quot;ref: Project\&quot;\n        date createdAt\n        date updatedAt\n    }\n \n    FOLLOWER {\n        ObjectId _id PK\n        ObjectId followerId FK \&quot;ref: User\&quot;\n        ObjectId followingId FK \&quot;ref: User\&quot;\n        date createdAt\n        date updatedAt\n    }\n \n    NOTIFICATION {\n        ObjectId _id PK\n        ObjectId userId FK \&quot;ref: User (recipient)\&quot;\n        string message\n        boolean isRead\n        date createdAt\n        date updatedAt\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mcFEpaTlbLVqioMOvuvG-1">
